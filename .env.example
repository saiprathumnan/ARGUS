# Copy to .env (docker compose) or export in your shell (local run). Never commit a filled-in copy.
POSTGRES_PASSWORD=change-me
ARGUS_API_KEY=change-me-to-a-long-random-string

# --- behaviour (defaults shown) ---
ARGUS_INTEL_OFFLINE=true            # true: only the bundled SAMPLE intelligence is consulted
ARGUS_ALLOW_NETWORK_FETCH=false     # true: submitted URLs are fetched through the SSRF guard
ARGUS_WORKERS=2                     # investigations analysed concurrently

# --- optional threat intelligence (used only when ARGUS_INTEL_OFFLINE=false) ---
ARGUS_VIRUSTOTAL_API_KEY=
ARGUS_ABUSEIPDB_API_KEY=
ARGUS_OTX_API_KEY=

# --- optional language model for report narrative: none | openai_compatible | anthropic ---
ARGUS_LLM_PROVIDER=none
ARGUS_LLM_BASE_URL=http://localhost:11434/v1   # Ollama / LM Studio / OpenAI-compatible
ARGUS_LLM_MODEL=llama3.1
ARGUS_LLM_API_KEY=

# --- frontend (Next.js server side only; never exposed to the browser) ---
ARGUS_BACKEND_URL=http://127.0.0.1:8000
