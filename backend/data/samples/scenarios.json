[
 {
  "id": "phishing-to-c2",
  "title": "Phishing email to workstation beaconing",
  "expected_verdict": "suspicious",
  "description": "A phishing email, a workstation packet capture and endpoint events that share infrastructure. Exercises cross-source correlation.",
  "evidence": [
   {
    "kind": "eml",
    "file": "phishing_email.eml"
   },
   {
    "kind": "pcap",
    "file": "workstation_capture.pcap"
   },
   {
    "kind": "json_events",
    "file": "endpoint_events.json"
   }
  ],
  "expected_detectors": [
   "email.link_text_mismatch",
   "email.spf_fail",
   "email.attachment_double_extension",
   "network.beaconing",
   "process.suspicious_powershell",
   "correlation.delivery_to_contact",
   "correlation.corroborated_indicator"
  ]
 },
 {
